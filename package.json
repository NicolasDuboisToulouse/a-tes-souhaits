    "helmet": "^8.1.0",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.13.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/config-helpers": "^0.5.1",
    "@eslint/css": "^0.14.1",
